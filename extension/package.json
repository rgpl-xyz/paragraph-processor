{
  "name": "paragraph-processor-extension",
  "version": "1.0.0",
  "description": "Chrome extension that counts words in paragraphs and highlights their noun phrases using an NLP API",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgpl-xyz/paragraph-processor.git",
    "directory": "extension"
  },
  "author": "RGPL",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/rgpl-xyz/paragraph-processor/issues"
  },
  "homepage": "https://github.com/rgpl-xyz/paragraph-processor/tree/main/extension#readme",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev": "webpack --mode development --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@tsconfig/recommended": "^1.0.7",
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-types": "^0.1.298",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^16.4.7",
    "jsdom": "^26.1.0",
    "playwright-core": "1.64.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-cli": "^6.0.1"
  }
}
