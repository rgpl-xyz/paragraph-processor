# Copy to .env and change what you need. Every value is optional; webpack.config.js holds the defaults.

# NLP API. The build also grants the extension access to this origin.
API_BASE_URL=http://localhost:8080
API_ENDPOINT=/noun_phrases
API_TIMEOUT=10000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# Noun phrase cache in the background worker
CACHE_DURATION=300000
MAX_CACHE_SIZE=1000
